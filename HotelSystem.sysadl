Model SysADLModel ; package SysADL.types { value type Int { } value type Boolean { } value type String { } value type Void { } value type Real { } dimension Currency unit Reais { dimension = Currency } value type Concurrency { dimension = Currency } value type ReaisConcurrency extends Concurrency { unit = Reais dimension = Currency } value type Timestamp { dimension = Timestamp } dimension Timestamp enum Signal { High , Low } datatype CredentialData { attributes : cardId : String ; token : String ; guestId : String ; } datatype AccessRequest { attributes : credential : CredentialData ; localId : String ; timestamp : Timestamp ; } datatype ConsumerTransaction { attributes : credentialData : CredentialData ; idPOS : String ; posInputData : POSInputData ; } datatype POSInputData { attributes : amount : Real ; itemId : String ; quantity : Int ; timestamp : Timestamp ; } datatype AccessResponse { attributes : granted : Boolean ; message : String ; } datatype CheckInData { attributes : guestId : String ; roomNumber : String ; validFrom : Timestamp ; validTo : Timestamp ; cardId : String ; allowedAreas : String ; } enum CacheOperations { ADD , UPDATE , REVOKE } datatype CacheUpdateData { attributes : checkIn : CheckInData ; operation : CacheOperations ; } }  package  HotelSystemConnectors { import HotelSystemPorts ; connector def CredentialDataCN { participants : ~ source : CredentialDataOPT ; ~ destination : CredentialDataIPT ; flows : CredentialData from source to destination connector def newElement { } } connector def SignalCN { participants : ~ source : SignalOPT ; ~ destination : SignalIPT ; flows : Signal from source to destination } connector def AccessRequestCN { participants : ~ source : AccessRequestOPT ; ~ destination : AccessRequestIPT ; flows : AccessRequest from source to destination } connector def ConsumerTransactionCN { participants : ~ source : ConsumerTransactionOPT ; ~ destination : ConsumerTransactionIPT ; flows : ConsumerTransaction from source to destination } connector def POSInputDataCN { participants : ~ source : POSInputDataOPT ; ~ destination : POSInputDataIPT ; flows : POSInputData from source to destination } connector def AccessResponseCN { participants : ~ source : AccessResponseOPT ; ~ destination : AccessResponseIPT ; flows : AccessResponse from source to destination } connector def CacheUpdateDataCN { participants : ~ source : CacheUpdateDataOPT ; ~ destination : CacheUpdateDataIPT ; flows : CacheUpdateData from source to destination } connector def CheckInDataCN { participants : ~ source : CheckInDataOPT ; ~ destination : CheckInDataIPT ; flows : CheckInData from source to destination } }  Requirement QualidadeSistemaDeHotelNFR ( 0 ) { text = "O sistema deve satisfazer os atributos de qualidade." Requirement DesempenhoNFR ( 1 ) { text = "O tempo de resposta entre a leitura do cartão RFID e o acionamento físico da tranca/catraca não deve exceder 300 ms." } Requirement DisponibilidadeNFR ( 2 ) { text = "Os controladores de acesso físicos devem manter a operação básica de libertação (cache local) mesmo em caso de falha de conectividade com o servidor central." } Requirement ModificabilidadeNFR ( 3 ) { text = "A arquitetura deve isolar os drivers de hardware dos leitores físicos, permitindo a substituição de modelos de leitores RFID ou atualizações de hardware sem impacto no núcleo do sistema." } Requirement SegurancaNFR ( 4 ) { text = "Toda a comunicação entre os terminais, a borda (edge) e o servidor central deve ser encriptada, e os pagamentos devem seguir padrões rigorosos de segurança e privacidade." } Requirement EscalabilidadeNFR ( 5 ) { text = "O sistema deve ser capaz de escalar horizontalmente para suportar uma elevada quantidade de clientes e milhares de eventos simultâneos de acesso e consumo." } Requirement SegurancaNFR ( 4 ) { text = "Toda a comunicação entre os terminais, a borda (edge) e o servidor central deve ser encriptada, e os pagamentos devem seguir padrões rigorosos de segurança e privacidade." } } Requirement SistemaDeHotelFR ( 0 ) { text = "O sistema deve atender às necessidades funcionais de gestão e automação do hotel." Requirement VincularCartaoFR ( 1 ) { text = "O sistema deve associar um cartão RFID à reserva do hóspede no momento do check-in, concedendo autorizações com base na data e horário agendados." } Requirement ControleAcessoFR ( 2 ) { text = "O sistema deve libertar ou bloquear o acesso a ambientes específicos do hotel (quartos, piscinas, saunas, ginásio) mediante a leitura do cartão RFID do hóspede." } Requirement RegistroConsumoFR ( 3 ) { text = " O sistema deve registar o consumo de bebidas e comidas utilizando exclusivamente o cartão RFID associado ao hóspede." } Requirement GestaoPagamentosRF ( 4 ) { text = "O sistema deve gerir pagamentos por pré-pagamento (inserção de créditos no cartão) ou acumular os débitos para pagamento final no check-out." } Requirement ConfiguracaoMultiEstabelecimentoFR ( 5 ) { text = "O sistema deve ser parametrizável para operar em diferentes estabelecimentos, permitindo o registo dinâmico de ambientes e regras de acesso." } } package HotelSystemComponents { import HotelSystemPorts ; import SysADL.types ; import HotelSystemConnectors ; component def RFIDReaderCP { ports : credentialOut : CredentialDataOPT ; }
	component def HotelSystem { configuration { components :     POSTerminalCP : POSTerminalCP { using ports : transcationOut : ConsumerTransactionOPT ; }  LocalGatewayCP : LocalGatewayCP { using ports : requestIn : AccessRequestIPT ; RequestOut : AccessRequestOPT ; } CentralServerCP : CentralServerCP { using ports : requestIn : AccessRequestIPT ; transactionIn : ConsumerTransactionIPT ; } connectors :      ConsumerTransactionCN : ConsumerTransactionCN bindings transcationOut = transactionIn ; } }
	component def DoorLock { ports : signalIn : SignalIPT ; }
	component def AccessControllerCP { ports : credentialIn : CredentialDataIPT ; signalOut : SignalOPT ; requestOut : AccessRequestOPT ; responseIn : AccessResponseIPT ; }
	component def LocalGatewayCP { ports : requestIn : AccessRequestIPT ; RequestOut : AccessRequestOPT ; responseOut : AccessResponseOPT ; cacheUpdateIn : CacheUpdateDataIPT ; }
	component def POSTerminalCP { ports : transcationOut : ConsumerTransactionOPT ; configuration { components : RFIDReaderCP : RFIDReaderCP { using ports : credentialOut : CredentialDataOPT ; } POSUserInterface : POSUserInterface { using ports : saleInputOut : POSInputDataOPT ; } POSTransactionProcessor : POSTransactionProcessor { using ports : credentialIn : CredentialDataIPT ; saleInputIn : POSInputDataIPT ; transactionOut : ConsumerTransactionOPT ; } connectors : credentialDataCN : CredentialDataCN bindings credentialOut = credentialIn ; POSInputDataCN : POSInputDataCN bindings saleInputOut = saleInputIn ; delegations : transactionOut to transcationOut } }
	component def CentralServerCP { ports : requestIn : AccessRequestIPT ; transactionIn : ConsumerTransactionIPT ; checkInRequest : CheckInDataIPT ; }
	component def AccessDoorKitCP { ports : requestOut : AccessRequestOPT ; responseIn : AccessResponseIPT ; configuration { components : RFIDReaderCP : RFIDReaderCP { using ports : credentialOut : CredentialDataOPT ; } DoorLock : DoorLock { using ports : signalIn : SignalIPT ; } AccessControllerCP : AccessControllerCP { using ports : credentialIn : CredentialDataIPT ; signalOut : SignalOPT ; requestOut : AccessRequestOPT ; responseIn : AccessResponseIPT ; } connectors : CredentialDataCN : CredentialDataCN bindings credentialOut = credentialIn ; SignalCN : SignalCN bindings signalOut = signalIn ; delegations : requestOut to requestOut responseIn to responseIn } }
	component def POSUserInterface { ports : saleInputOut : POSInputDataOPT ; }
	component def POSTransactionProcessor { ports : credentialIn : CredentialDataIPT ; saleInputIn : POSInputDataIPT ; transactionOut : ConsumerTransactionOPT ; } boundary
	component def ReceptionTerminalCP { ports : cardWrite : CredentialDataOPT ; checkInRequest : CheckInDataOPT ; cacheUpdateOut : CacheUpdateDataOPT ; }
	component def RFIDWriterCP { ports : cardWriteIn : CredentialDataIPT ; credentialDataOut : CredentialDataOPT ; } } package HotelSystemPorts { import SysADL.types ; port def AccessRequestIPT { flow in AccessRequest } port def AccessRequestOPT { flow out AccessRequest } port def CredentialDataIPT { flow in CredentialData } port def CredentialDataOPT { flow out CredentialData } port def ConsumerTransactionIPT { flow in ConsumerTransaction } port def ConsumerTransactionOPT { flow out ConsumerTransaction } port def SignalIPT { flow in Signal } port def SignalOPT { flow out Signal } port def POSInputDataIPT { flow in POSInputData } port def POSInputDataOPT { flow out POSInputData } port def AccessResponseIPT { flow in AccessResponse } port def AccessResponseOPT { flow out AccessResponse } port def CheckInDataIPT { flow in CheckInData } port def CheckInDataOPT { flow out CheckInData } port def CacheUpdateDataIPT { flow in CacheUpdateData } port def CacheUpdateDataOPT { flow out CacheUpdateData } }