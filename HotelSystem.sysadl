Model SysADLModel ; package SysADL.types { value type Int { } value type Boolean { } value type String { } value type Void { } value type Real { } dimension Currency unit Reais { dimension = Currency } value type Concurrency { dimension = Currency } value type ReaisConcurrency extends Concurrency { unit = Reais dimension = Currency } value type Timestamp { dimension = Timestamp } dimension Timestamp enum Signal { High , Low } datatype CredentialData { attributes : cardId : String ; token : String ; guestId : String ; } datatype AccessRequest { attributes : credential : CredentialData ; localId : String ; timestamp : Timestamp ; } datatype ConsumerTransaction { attributes : credentialData : CredentialData ; idPOS : String ; ^value : Real ; } }  package  HotelSystemConnectors { import HotelSystemPorts ; }  Requirement QualidadeSistemaDeHotelNFR ( 0 ) { text = "O sistema deve satisfazer os atributos de qualidade." Requirement DesempenhoNFR ( 1 ) { text = "O tempo de resposta entre a leitura do cartão RFID e o acionamento físico da tranca/catraca não deve exceder 300 ms." } Requirement DisponibilidadeNFR ( 2 ) { text = "Os controladores de acesso físicos devem manter a operação básica de libertação (cache local) mesmo em caso de falha de conectividade com o servidor central." } Requirement ModificabilidadeNFR ( 3 ) { text = "A arquitetura deve isolar os drivers de hardware dos leitores físicos, permitindo a substituição de modelos de leitores RFID ou atualizações de hardware sem impacto no núcleo do sistema." } Requirement SegurancaNFR ( 4 ) { text = "Toda a comunicação entre os terminais, a borda (edge) e o servidor central deve ser encriptada, e os pagamentos devem seguir padrões rigorosos de segurança e privacidade." } Requirement EscalabilidadeNFR ( 5 ) { text = "O sistema deve ser capaz de escalar horizontalmente para suportar uma elevada quantidade de clientes e milhares de eventos simultâneos de acesso e consumo." } Requirement SegurancaNFR ( 4 ) { text = "Toda a comunicação entre os terminais, a borda (edge) e o servidor central deve ser encriptada, e os pagamentos devem seguir padrões rigorosos de segurança e privacidade." } } Requirement SistemaDeHotelFR ( 0 ) { text = "O sistema deve atender às necessidades funcionais de gestão e automação do hotel." Requirement VincularCartaoFR ( 1 ) { text = "O sistema deve associar um cartão RFID à reserva do hóspede no momento do check-in, concedendo autorizações com base na data e horário agendados." } Requirement ControleAcessoFR ( 2 ) { text = "O sistema deve libertar ou bloquear o acesso a ambientes específicos do hotel (quartos, piscinas, saunas, ginásio) mediante a leitura do cartão RFID do hóspede." } Requirement RegistroConsumoFR ( 3 ) { text = " O sistema deve registar o consumo de bebidas e comidas utilizando exclusivamente o cartão RFID associado ao hóspede." } Requirement GestaoPagamentosRF ( 4 ) { text = "O sistema deve gerir pagamentos por pré-pagamento (inserção de créditos no cartão) ou acumular os débitos para pagamento final no check-out." } Requirement ConfiguracaoMultiEstabelecimentoFR ( 5 ) { text = "O sistema deve ser parametrizável para operar em diferentes estabelecimentos, permitindo o registo dinâmico de ambientes e regras de acesso." } } package HotelSystemComponents { import HotelSystemPorts ; import SysADL.types ; import HotelSystemConnectors ; } package HotelSystemPorts { import SysADL.types ; }